# ---- Future Pro environment ----
# Salin file ini jadi .env.local lalu isi nilainya.

# Password untuk login halaman Agen (/masuk). WAJIB diganti saat produksi.
ADMIN_PASSWORD=admin123

# Secret untuk menandatangani cookie sesi. Isi string acak panjang saat produksi.
APP_SECRET=ganti-dengan-string-acak-panjang

# Kunci Claude API untuk parsing chat + foto jadi listing otomatis.
# Dapatkan di https://console.anthropic.com. Tanpa ini, app pakai parser sederhana.
ANTHROPIC_API_KEY=

# (Opsional) Model Claude untuk parsing. Default: claude-haiku-5-5 (cepat & hemat).
# ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Branding (opsional, boleh dikosongkan) ----
NEXT_PUBLIC_SITE_NAME=Future Pro
NEXT_PUBLIC_SITE_TAGLINE=Properti pilihan di Jakarta, Tangsel & sekitarnya
NEXT_PUBLIC_AGENT_NAME=Agen Future Pro

# Nomor WhatsApp untuk tombol "Hubungi" (format internasional tanpa +).
NEXT_PUBLIC_WA_NUMBER=6281234567890
